{
  "name": "sos-sdk-node-ts",
  "version": "0.2.2",
  "description": "Product-neutral Node adapters shared by SOSChain, Vet and UHC runtimes",
  "license": "Apache-2.0",
  "author": "Connecting Solution & Applications Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soschain/sos-sdk-node-ts.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./portal-web-push": {
      "types": "./dist/portal-web-push.d.ts",
      "default": "./dist/portal-web-push.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./emergency-dispatch": {
      "types": "./dist/emergency-dispatch.d.ts",
      "default": "./dist/emergency-dispatch.js"
    },
    "./prompt-audio-runtime": {
      "types": "./dist/prompt-audio-runtime.d.ts",
      "default": "./dist/prompt-audio-runtime.js"
    },
    "./secure-message-crypto": {
      "types": "./dist/secure-message-crypto.d.ts",
      "default": "./dist/secure-message-crypto.js"
    },
    "./bundle-sync-service": {
      "types": "./dist/bundle-sync-service.d.ts",
      "default": "./dist/bundle-sync-service.js"
    },
    "./encounter-transfer-audience-service": {
      "types": "./dist/encounter-transfer-audience-service.d.ts",
      "default": "./dist/encounter-transfer-audience-service.js"
    },
    "./confidential-channel-cache": {
      "types": "./dist/confidential-channel-cache.d.ts",
      "default": "./dist/confidential-channel-cache.js"
    },
    "./portal-rtc-livekit": {
      "types": "./dist/portal-rtc-livekit.d.ts",
      "default": "./dist/portal-rtc-livekit.js"
    },
    "./bff-email-assertion": {
      "types": "./dist/bff-email-assertion.d.ts",
      "default": "./dist/bff-email-assertion.js"
    },
    "./subject-card-directory-client": {
      "types": "./dist/subject-card-directory-client.d.ts",
      "default": "./dist/subject-card-directory-client.js"
    },
    "./host-organization-directory-client": {
      "types": "./dist/host-organization-directory-client.d.ts",
      "default": "./dist/host-organization-directory-client.js"
    },
    "./secure-organization-registration": {
      "types": "./dist/secure-organization-registration.d.ts",
      "default": "./dist/secure-organization-registration.js"
    },
    "./portable-professional-evidence": {
      "types": "./dist/portable-professional-evidence.d.ts",
      "default": "./dist/portable-professional-evidence.js"
    },
    "./subject-card-provider-catalog-client": {
      "types": "./dist/subject-card-provider-catalog-client.d.ts",
      "default": "./dist/subject-card-provider-catalog-client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "antifraud-data-utils-ts": "0.2.0",
    "gdc-common-utils-ts": "2.9.30",
    "gdc-sdk-node-ts": "2.9.32",
    "livekit-server-sdk": "2.19.2",
    "sos-data-utils-ts": "0.6.30",
    "sos-sdk-core-ts": "0.5.5",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@peculiar/x509": "1.14.3",
    "@types/node": "^24.10.0",
    "@types/web-push": "3.6.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
